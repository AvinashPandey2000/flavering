{
  "name": "AwesomeProject",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:one": "cd android && ./gradlew :app:installOneDebug -PreactNativeDevServerPort=8081",
    "android:two": "cd android && ./gradlew :app:installTwoDebug -PreactNativeDevServerPort=8081",
    "android:three": "cd android && ./gradlew :app:installThreeDebug -PreactNativeDevServerPort=8081",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "build:android:one": "cd android && ./gradlew assembleOneRelease",
    "build:android:two": "cd android && ./gradlew assembleTwoRelease",
    "build:android:three": "cd android && ./gradlew assembleThreeRelease",
    "bundle:android:one": "cd android && ./gradlew bundleOneRelease",
    "bundle:android:two": "cd android && ./gradlew bundleTwoRelease",
    "bundle:android:three": "cd android && ./gradlew bundleThreeRelease",
    "build:ios:one": "xcodebuild -workspace ios/AwesomeProject.xcworkspace -scheme One -configuration Release archive -archivePath ios/build/One.xcarchive -destination 'generic/platform=iOS'",
    "build:ios:two": "xcodebuild -workspace ios/YourApp.xcworkspace -scheme Two -configuration Release archive -archivePath ios/build/Two.xcarchive",
    "build:ios:three": "xcodebuild -workspace ios/YourApp.xcworkspace -scheme Three -configuration Release archive -archivePath ios/build/Three.xcarchive",
    "make:one": "npm run build:android:one && npm run build:ios:one",
    "make:two": "npm run build:android:two && npm run build:ios:two",
    "make:three": "npm run build:android:three && npm run build:ios:three",
    "test": "jest"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/elements": "^2.9.5",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.1",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-config": "^1.6.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}